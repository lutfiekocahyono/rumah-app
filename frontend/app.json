{
  "expo": {
    "name": "Pusat Grosir Sidoarjo",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pgs",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.rumahapp.mqe765",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcode dan cari produk dengan foto",
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSLocationWhenInUseUsageDescription": "Tampilkan cabang & ongkir terdekat untuk Anda",
        "NSPhotoLibraryUsageDescription": "Pilih foto barang untuk dicari"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.rumahapp.mqe765",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Pusat Grosir Sidoarjo",
      "themeColor": "#F15A24"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto barang atau banner dari galeri",
          "cameraPermission": "Foto barang untuk mencari produk serupa"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcode dan cari produk dengan foto",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tampilkan cabang & ongkir terdekat untuk Anda"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}